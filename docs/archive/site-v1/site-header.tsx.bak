import Link from 'next/link';
import { Logo } from '@/components/brand/logo';
import { siteConfig } from '@/config/site';
import { hero } from '@/content/site-content';
import { container } from './ui';

export function SiteHeader() {
  return (
    <header className="sticky top-0 z-40 border-b border-hairline bg-white/90 backdrop-blur">
      <div className={`${container} flex h-16 items-center gap-6`}>
        <Link href="/" aria-label={`${siteConfig.name} home`} className="shrink-0">
          <Logo />
        </Link>
        <nav aria-label="Main" className="ml-auto hidden items-center gap-6 md:flex">
          {siteConfig.nav.map((item) => (
            <Link key={item.href} href={item.href} className="text-[0.95rem] font-semibold text-night-soft hover:text-night">
              {item.label}
            </Link>
          ))}
        </nav>
        <a href={hero.primary.href} className="ml-auto inline-flex h-10 items-center rounded-full bg-masala px-4 text-sm font-semibold text-white hover:bg-masala-hover md:ml-0">
          {hero.primary.label}
        </a>
      </div>
    </header>
  );
}
