/* ------------------------------------------------------------------
   The story. The home page is a Victorian showman's tour of how food
   sellers have shown their menus, from the street cry to the telly.
   The narration may flourish; product facts above stay plain.
------------------------------------------------------------------- */

export const overture = {
  wordmark: 'MenuTelly',
  tagline: 'Your menu, on the telly.',
  seal: '✶ Menus for every age ✶ Established MMXXVI ',
  skip: 'Skip the overture',
} as const;

export const playbill = {
  presents: 'By popular demand, the proprietors of MenuTelly present',
  title: 'The remarkable history of the menu.',
  subtitle: 'From the street cry to the telly on your wall, in seven acts.',
  lead: 'Step this way. For centuries, sellers of food have shouted, chalked, printed, pasted and lit up their menus. Each way did one job well and failed at another. Scroll on to meet them all, and the screen that finally does every job at once.',
  begin: { label: 'Begin the tour', href: '#act-1' },
  admission: 'Admission free. Seven acts and a marvel.',
  ribbon: 'Hear ye ✶ Chalk it up ✶ Bill of fare ✶ Post no bills ✶ Electric light ✶ Now showing ✶ Your menu, on the telly ✶ ',
} as const;

export interface Act {
  readonly id: string;
  readonly numeral: string;
  /** Roughly when the act is set; the chapter plate counts up to it from the act before. */
  readonly year: number;
  readonly era: string;
  readonly title: string;
  readonly body: string;
  readonly moral: string;
}

export const acts = [
  {
    id: 'act-1',
    numeral: 'I',
    year: 1750,
    era: 'The street cry',
    title: 'Hear ye, hear ye.',
    body: 'Before anything was written down, the menu was a voice. Pie men, oyster sellers and chai wallahs sang out what they had and what it cost. Loud, cheap and hard to ignore, until the seller lost his voice or turned the corner.',
    moral: 'A menu has to carry across a busy room.',
  },
  {
    id: 'act-2',
    numeral: 'II',
    year: 1820,
    era: 'The slate',
    title: 'Chalk it up.',
    body: 'Taverns and coffee houses hung a slate by the door. The day’s fare went up in chalk and came off with a damp cloth. A price could change in seconds and a finished dish could vanish with one swipe: the first quick action. But chalk smudges, fades and is hard to read from the door.',
    moral: 'Changing the menu should take seconds.',
  },
  {
    id: 'act-3',
    numeral: 'III',
    year: 1860,
    era: 'The printing press',
    title: 'The bill of fare.',
    body: 'Then came the printing press and the grand dining room. Menus were set in metal type, inked and pressed onto card: handsome, orderly and the same at every table. They were also wrong the morning a price changed, so many a fine bill of fare ended its days in the stove.',
    moral: 'Every reprint costs money. Every stale price costs trust.',
  },
  {
    id: 'act-4',
    numeral: 'IV',
    year: 1885,
    era: 'Posters and sandwich men',
    title: 'Post no bills.',
    body: 'By the 1880s, every blank wall in town was papered with posters, and men walked the streets between two painted boards. Food went looking for hungry people. But Monday’s poster still shouted Monday’s prices on Friday, and a sandwich man could stand on only one corner.',
    moral: 'Show today’s special where guests are standing.',
  },
  {
    id: 'act-5',
    numeral: 'V',
    year: 1935,
    era: 'Electric light',
    title: 'Electric light!',
    body: 'Electricity turned signs into beacons. Bulbs chased round cinema marquees, neon glowed over diners, and menu boards got rows of slots for snap-in letters and prices. Bright enough to read from across the street. Changing one took a ladder, a box of letters and a steady hand.',
    moral: 'Light gets noticed. Ladders don’t get climbed.',
  },
  {
    id: 'act-6',
    numeral: 'VI',
    year: 1980,
    era: 'The television',
    title: 'Now showing.',
    body: 'Then came television, and before long every café had a set on the wall. It showed cricket, film songs and the news while the menu stayed on paper: the brightest thing in the shop was selling someone else’s show. Signage screens followed, with a computer, a designer and a pen drive for every change.',
    moral: 'The brightest thing in the room should sell your food.',
  },
  {
    id: 'act-7',
    numeral: 'VII',
    year: 2026,
    era: 'The telly',
    title: 'The telly, at last.',
    body: 'Ladies and gentlemen, the marvel of the age. Every lesson above, in one link: a menu that carries across the room, changes from your phone in seconds, never needs a reprint, puts today’s special where guests are standing, and glows on the TV you already own.',
    moral: 'Your menu, on the telly.',
  },
] as const satisfies readonly Act[];

