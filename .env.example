# Canonical site URL for metadata, sitemap and agent files. On Netlify the build fills it from the site's URL
# (netlify.toml); elsewhere it falls back to the Vercel production URL, then localhost.
NEXT_PUBLIC_SITE_URL=

# Team password (Basic Auth) for /tracker and /api/tracker. Without it, production locks them; locally they're open.
# The owner app at /studio uses restaurant accounts instead (sign in with a code at /sign-in).
TRACKER_PASSWORD=

# Sign-in codes. Email goes through Resend, text messages through Twilio (+91 numbers only; Indian SMS also needs a
# DLT-registered template). With neither set, development shows the code on screen and production refuses to pretend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Test sites only: with no provider set, show sign-in codes on screen in a production build. Anyone could then
# sign in as anyone, so never set this on the real site.
SIGN_IN_CODES_ON_SCREEN=

# Menu from a photo (tracker MT-19): the server reads menu photos with Claude. Without it, owners are asked to paste instead.
ANTHROPIC_API_KEY=

# Storage. On Netlify, data lives in Netlify Database (Postgres, one row per document; NETLIFY_DB_URL is injected) and
# dish photos in Netlify Blobs; nothing to set. Locally (and on a host without them) it's the JSON files below.
# Optional data file locations. Defaults: data/tracker.json and data/waitlist.json (on a serverless host: /tmp, temporary).
TRACKER_DATA_FILE=
WAITLIST_DATA_FILE=
# Screens, TV links (hashed) and pairing requests. Default: data/screens.json.
SCREENS_DATA_FILE=
# People, sessions (hashed), sign-in codes (hashed), restaurants and teams. Default: data/accounts.json (gitignored).
ACCOUNTS_DATA_FILE=
# Each restaurant's menu, and the folder for dish photos. Defaults: data/menus.json and data/photos/ (gitignored).
MENUS_DATA_FILE=
PHOTOS_DIR=

# Google Search Console verification code (the content of its meta tag), to verify the site and submit the sitemap.
GOOGLE_SITE_VERIFICATION=
